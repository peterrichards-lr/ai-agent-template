# Multi-Language & AI Agent .gitignore

# Operating System Files
.DS_Store
Thumbs.db
*.swp
*.swo

# AI Agent Per-User State (never commit; shared configs in these dirs are tracked)
.claude/settings.local.json
.claude/worktrees/
.gemini/settings.local.json
.agent-state.md
# (its tracked seed lives at .agents/templates/agent-state.md and must stay committed)
.agent_scratch/
.progress-signal
scratch/
implementation_plan.md
walkthrough.md
*.tmp
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.smoke_venv/
.temp_venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Go
bin/
*.exe
*.exe?
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt

# Rust
/target/
**/*.rs.bk
Cargo.lock

# Java / Maven / Gradle
.gradle/
build/
target/
*.class
*.jar
*.war
*.ear

# TypeScript / Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/

# Secret Baselines & Local Overrides
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# Security scan reports (local `semgrep scan --sarif --output ...` runs)
*.sarif

# MkDocs (the optional documentation site; see mkdocs.yml)
site/
_site/
# The site home page is copied from README.md at build time -- by
# .github/workflows/docs.yml in CI, and by hand before a local `mkdocs serve` --
# so the GitHub landing page and the site home cannot drift apart. Committing it
# would recreate exactly the duplicate this arrangement exists to avoid.
docs/index.md
